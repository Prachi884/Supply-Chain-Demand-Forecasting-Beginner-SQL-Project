-- ================================================================
-- Supply Chain Demand Forecasting — Beginner SQL Analysis
-- 10 business questions, using only beginner SQL concepts:
-- SELECT, WHERE, JOIN, GROUP BY, ORDER BY, LIMIT, COUNT, SUM, AVG, BETWEEN.
-- No subqueries, CTEs, or window functions.
-- Run this after schema.sql and after loading data/*.csv into the
-- stores, products, and daily_sales tables.
-- ================================================================


-- Q1. Business question: "Which product categories generate the most total revenue?"
-- Revenue = units_sold * unit_price
SELECT
    p.category,
    ROUND(SUM(s.units_sold * s.unit_price), 2) AS total_revenue
FROM daily_sales s
JOIN products p ON s.product_id = p.product_id
GROUP BY p.category
ORDER BY total_revenue DESC;


-- Q2. Business question: "What are our top 10 best-selling products by units sold?"
-- Helps merchandising decide what to keep well-stocked.
SELECT
    p.product_name,
    p.category,
    SUM(s.units_sold) AS total_units_sold
FROM daily_sales s
JOIN products p ON s.product_id = p.product_id
GROUP BY p.product_id, p.product_name, p.category
ORDER BY total_units_sold DESC
LIMIT 10;


-- Q3. Business question: "How many stores do we have in each region?"
SELECT
    region,
    COUNT(*) AS store_count
FROM stores
GROUP BY region
ORDER BY store_count DESC;


-- Q4. Business question: "Which 10 stores experienced the most stockout days?"
-- A stockout means we lost potential sales because demand outpaced inventory.
SELECT
    st.store_name,
    st.region,
    COUNT(*) AS stockout_days
FROM daily_sales s
JOIN stores st ON s.store_id = st.store_id
WHERE s.stockout_flag = 1
GROUP BY st.store_id, st.store_name, st.region
ORDER BY stockout_days DESC
LIMIT 10;


-- Q5. Business question: "What is the average selling price per category?"
-- Useful for pricing strategy checks.
SELECT
    category,
    ROUND(AVG(unit_price), 2) AS avg_unit_price
FROM products
GROUP BY category
ORDER BY avg_unit_price DESC;


-- Q6. Business question: "How many sales transactions happened during promotions
-- vs. regular price, and how many units did each account for?"
SELECT
    promotion_flag,
    COUNT(*) AS num_transactions,
    SUM(units_sold) AS total_units_sold
FROM daily_sales
GROUP BY promotion_flag;


-- Q7. Business question: "What did demand look like during the 2023 holiday season
-- (Nov-Dec), when Electronics and Toys typically spike?"
SELECT
    p.category,
    SUM(s.units_demanded) AS total_demand,
    SUM(s.units_sold) AS total_sold
FROM daily_sales s
JOIN products p ON s.product_id = p.product_id
WHERE s.sale_date BETWEEN '2023-11-01' AND '2023-12-31'
GROUP BY p.category
ORDER BY total_demand DESC;


-- Q8. Business question: "Which suppliers do we rely on most, by number of
-- products supplied?" Relevant to supplier-concentration / single-source risk.
SELECT
    supplier_name,
    COUNT(*) AS num_products_supplied
FROM products
GROUP BY supplier_name
ORDER BY num_products_supplied DESC;


-- Q9. Business question: "What is the total revenue and profit generated by
-- each region?" Three-table join: daily_sales -> stores -> products.
SELECT
    st.region,
    ROUND(SUM(s.units_sold * s.unit_price), 2) AS total_revenue,
    ROUND(SUM(s.units_sold * (s.unit_price - p.unit_cost)), 2) AS total_profit
FROM daily_sales s
JOIN stores st  ON s.store_id = st.store_id
JOIN products p ON s.product_id = p.product_id
GROUP BY st.region
ORDER BY total_revenue DESC;


-- Q10. Business question: "Which 10 products had the highest number of
-- stockout days?" Flags the products most in need of a better reorder policy.
SELECT
    p.product_name,
    p.category,
    SUM(s.stockout_flag) AS stockout_days
FROM daily_sales s
JOIN products p ON s.product_id = p.product_id
GROUP BY p.product_id, p.product_name, p.category
ORDER BY stockout_days DESC
LIMIT 10;
